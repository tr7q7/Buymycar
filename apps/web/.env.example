# URL de base de l'API FastAPI consommée par le frontend.
# Copier ce fichier en .env.local et adapter la valeur.

# Backend FastAPI local (recommandé pour le développement intégré) :
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alternative sans backend : mocks Next.js intégrés (UI seule, données factices)
# NEXT_PUBLIC_API_URL=/mock

# En production : URL du service Render, ex.
# NEXT_PUBLIC_API_URL=https://lcb-api.onrender.com
